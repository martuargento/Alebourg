{
  "expo": {
    "name": "Alebourg",
    "slug": "alebourg-mobile",
    "version": "1.0.3",
    "scheme": "alebourg",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.alebourg.mobile"
    },
    "android": {
      "package": "com.alebourg.mobile",
      "versionCode": 4,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/app-icon.png"
      }
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-navigation-bar",
        {
          "style": "dark",
          "enforceContrast": false
        }
      ]
    ],
    "extra": {
      "expo-navigation-bar": {
        "enforceContrast": false,
        "style": "dark"
      },
      "eas": {
        "projectId": "caf050dd-1f2c-49b8-9846-2c815c474a72"
      }
    },
    "owner": "alebourg"
  }
}
