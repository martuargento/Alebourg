{
  "name": "alebourg-backend",
  "version": "1.0.0",
  "description": "Backend Node.js para Alebourg",
  "private": true,
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "npm run db:generate",
    "postinstall": "npm run db:generate",
    "db:generate": "prisma generate && prisma generate --schema prisma/schema.production.prisma",
    "db:push": "prisma db push",
    "db:push:production": "prisma db push --schema prisma/schema.production.prisma",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "prisma": "^6.19.3"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "minimatch": "^11.0.1",
    "proxy-addr": "^2.0.8",
    "qs": "^6.16.1"
  }
}
