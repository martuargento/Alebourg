# Local SQLite is configured in prisma/schema.prisma.
# Generate a long random secret before using the admin login.
JWT_SECRET_KEY=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Comma-separated browser origins. Do not include trailing slashes.
CORS_ORIGINS=http://localhost:5173

# Used only by the production PostgreSQL schema.
DATABASE_URL=
DIRECT_URL=

# Optional: required only for administrator image uploads to Supabase Storage.
# Keep the service-role key exclusively in the backend deployment environment.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=productos
